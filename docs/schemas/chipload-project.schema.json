                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Stop a thin skin above the end depth and cut through it last\n(docs/specs/finish-and-skin.md). Missing: none."
            },
            "start_depth": {
              "description": "Where the cut starts and ends, mm down from the stock top (docs/specs/\ndepths-and-clearance.md): 0 <= start_depth < end_depth.",
              "format": "double",
              "type": "number"
            },
            "starts": {
              "default": [],
              "description": "Where rings start, in drawing coordinates (mm): each point moves the start of the\nring nearest to it (docs/specs/helix-and-leads.md, part A). Missing: none.",
              "items": {
                "items": {
                  "format": "double",
                  "type": "number"
                },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            "step_down": {
              "format": "double",
              "type": "number"
            },
            "tabs": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Tabs"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            },
            "tool": {
              "format": "int64",
              "type": "integer"
            },
            "type": {
              "const": "profile",
              "type": "string"
            }
          },
          "required": [
            "type",
            "select",
            "side",
            "direction",
            "tool",
            "start_depth",
            "end_depth",
            "clearance",
            "step_down",
            "feed",
            "plunge_feed"
          ],
          "type": "object"
        },
        {
