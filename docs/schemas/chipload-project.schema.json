{
  "$defs": {
    "ArcSegment": {
      "additionalProperties": false,
      "description": "From `start_angle` through `sweep` radians (positive = counter-clockwise).",
      "properties": {
        "center": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "radius": {
          "format": "double",
          "type": "number"
        },
        "start_angle": {
          "format": "double",
          "type": "number"
        },
        "sweep": {
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "center",
        "radius",
        "start_angle",
        "sweep"
      ],
      "type": "object"
    },
    "Copies": {
      "additionalProperties": false,
      "description": "A grid of copies of the whole part: copy (column c, row r) is the drawing moved by\n(c·dx, r·dy) mm.",
      "properties": {
        "columns": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "dx": {
          "format": "double",
          "type": "number"
        },
        "dy": {
          "format": "double",
          "type": "number"
        },
        "order": {
          "$ref": "#/$defs/CopyOrder",
          "default": "by_operation"
        },
        "rows": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "columns",
        "rows",
        "dx",
        "dy"
      ],
      "type": "object"
    },
    "CopyOrder": {
      "description": "In which order the copies are cut.",
      "oneOf": [
        {
          "const": "by_operation",
          "description": "Each operation on every copy, then the next operation.",
          "type": "string"
        },
        {
          "const": "by_part",
          "description": "Every operation on one copy, then the next copy.",
          "type": "string"
        }
      ]
    },
    "Corners": {
      "description": "How the tool reaches into the inside corners it would leave round\n(docs/specs/dogbones.md): every corner on the tool's side up to `max_angle` (radians,\n0 < angle < 180°).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "In along the corner's bisector.",
          "properties": {
            "max_angle": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "dogbone",
              "type": "string"
            }
          },
          "required": [
            "type",
            "max_angle"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "In along the longer wall: the notch is in the shorter one.",
          "properties": {
            "max_angle": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "tbone",
              "type": "string"
            }
          },
          "required": [
            "type",
            "max_angle"
          ],
          "type": "object"
        }
      ]
    },
    "CustomPost": {
      "additionalProperties": false,
      "description": "A user post-processor's config and template, exactly as read from the posts folder.",
      "properties": {
        "config": {
          "description": "The config, TOML text.",
          "type": "string"
        },
        "template": {
          "description": "The template the config names, text.",
          "type": "string"
        }
      },
      "required": [
        "config",
        "template"
      ],
      "type": "object"
    },
    "Direction": {
      "enum": [
        "climb",
        "conventional"
      ],
      "type": "string"
    },
    "Drawing": {
      "additionalProperties": false,
      "description": "The project's drawing: shapes in millimetres, or (only for jobs from before v4) a\nreference to a DXF that still has to be embedded.",
      "properties": {
        "next_shape_id": {
          "description": "The id the next new shape gets. Ids are never reused.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "shapes": {
          "items": {
            "$ref": "#/$defs/Shape"
          },
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/DrawingSource"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where the imported shapes came from (the last import or update)."
        }
      },
      "required": [
        "shapes",
        "next_shape_id"
      ],
      "type": "object"
    },
    "DrawingSource": {
      "additionalProperties": false,
      "description": "Provenance of the imported shapes.",
      "properties": {
        "file": {
          "type": "string"
        },
        "flattened": {
          "additionalProperties": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "ignored": {
          "additionalProperties": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "imported": {
          "additionalProperties": {
            "format": "uint",
            "minimum": 0,
            "type": "integer"
          },
          "default": {},
          "type": "object"
        },
        "issues": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceIssue"
          },
          "type": "array"
        },
        "placement": {
          "$ref": "#/$defs/Placement",
          "description": "How far the imported shapes are moved from where the DXF has them; the stored shapes\nare the moved ones (docs/specs/drawing-placement.md)."
        },
        "sha256": {
          "type": "string"
        },
        "units": {
          "$ref": "#/$defs/Units"
        },
        "units_from": {
          "$ref": "#/$defs/UnitsFrom"
        }
      },
      "required": [
        "file",
        "sha256",
        "units",
        "units_from",
        "placement"
      ],
      "type": "object"
    },
    "Entry": {
      "description": "How the tool goes down into the material at the start of each pass\n(docs/specs/ramp-entry.md).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Straight down: needs a centre-cutting tool. An empty struct variant, as `Rings`.",
          "properties": {
            "type": {
              "const": "plunge",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Down along the path and back, never steeper than `ramp_angle` (radians,\n0 < angle <= 30°).",
          "properties": {
            "ramp_angle": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "ramp",
              "type": "string"
            }
          },
          "required": [
            "type",
            "ramp_angle"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Pockets only: down round a circle of `radius` (of the tool centre, mm, less than\nthe tool radius), never steeper than `ramp_angle` (docs/specs/helix-and-leads.md\npart C).",
          "properties": {
            "radius": {
              "format": "double",
              "type": "number"
            },
            "ramp_angle": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "helix",
              "type": "string"
            }
          },
          "required": [
            "type",
            "radius",
            "ramp_angle"
          ],
          "type": "object"
        }
      ]
    },
    "Finish": {
      "additionalProperties": false,
      "description": "A finishing pass on a profile (docs/specs/finish-and-skin.md).",
      "properties": {
        "stock": {
          "description": "Left on the wall by the roughing laps, mm: more than 0, less than the tool radius.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "stock"
      ],
      "type": "object"
    },
    "HoleMethod": {
      "description": "How a Holes operation cuts (docs/specs/holes.md §2).",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Straight down at the centre; `peck` mm at a time (None: in one go).",
          "properties": {
            "peck": {
              "format": "double",
              "type": [
                "number",
                "null"
              ]
            },
            "type": {
              "const": "drill",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A helix at the wall, at most `step_down` mm per turn and never steeper than\n`ramp_angle` (radians, 0 < angle <= 30°), then one level circle.",
          "properties": {
            "direction": {
              "$ref": "#/$defs/Direction"
            },
            "ramp_angle": {
              "format": "double",
              "type": "number"
            },
            "step_down": {
              "format": "double",
              "type": "number"
            },
            "type": {
              "const": "bore",
              "type": "string"
            }
          },
          "required": [
            "type",
            "step_down",
            "ramp_angle",
            "direction"
          ],
          "type": "object"
        }
      ]
    },
    "IssueSeverity": {
      "enum": [
        "warning",
        "error"
      ],
      "type": "string"
    },
    "Lead": {
      "additionalProperties": false,
      "description": "Quarter-circle lead-in and lead-out (docs/specs/helix-and-leads.md part B).",
      "properties": {
        "radius": {
          "description": "Of the arcs the tool centre follows, mm: more than 0, at most 10 × the tool diameter.",
          "format": "double",
          "type": "number"
        }
      },
      "required": [
        "radius"
      ],
      "type": "object"
    },
    "LineSegment": {
      "additionalProperties": false,
      "properties": {
        "end": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "start": {
          "items": {
            "format": "double",
            "type": "number"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "type": "object"
    },
    "Machine": {
      "additionalProperties": false,
      "properties": {
        "custom_post": {
          "anyOf": [
            {
              "$ref": "#/$defs/CustomPost"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A user post-processor as copied into the project when it was chosen\n(docs/specs/user-posts.md §3); null: `post` names a built-in post. Since schema 15."
        },
        "max_feed": {
          "default": null,
          "format": "double",
          "type": [
            "number",
            "null"
          ]
        },
        "name": {
          "default": null,
          "description": "The machine profile these values came from (docs/specs/tool-library-and-machines.md\n§4). Only a note: planning and G-code never read it.",
          "type": [
            "string",
            "null"
          ]
        },
        "post": {
          "type": "string"
        },
        "safe_z": {
          "format": "double",
          "type": "number"
        },
        "spindle": {
          "$ref": "#/$defs/Spindle"
        },
        "tool_change": {
          "$ref": "#/$defs/ToolChange",
          "description": "One file per tool group or one file with M6 (schema 12)."
        },
        "travel": {
          "anyOf": [
            {
              "$ref": "#/$defs/Travel"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "work_zero": {
          "$ref": "#/$defs/WorkZero",
          "default": {
            "at": "drawing_origin"
          },
          "description": "The drawing point that becomes X0 Y0 in the G-code (docs/specs/work-zero.md).\nMissing in older files: the drawing origin, as before."
        }
      },
      "required": [
        "post",
        "safe_z",
        "spindle",
        "tool_change"
      ],
      "type": "object"
    },
    "Operation": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "clearance": {
              "description": "How far the cut moves into the material that is kept, mm: positive gives a larger\npocket or a smaller part, negative leaves material. Less than the tool radius.",
              "format": "double",
              "type": "number"
            },
            "corners": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Corners"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Dogbones or T-bones in the inside corners (docs/specs/dogbones.md). Missing: none."
            },
            "direction": {
              "$ref": "#/$defs/Direction"
            },
            "enabled": {
              "default": true,
              "description": "Disabled operations stay in the file and are skipped when generating.",
              "type": "boolean"
            },
            "end_depth": {
              "format": "double",
              "type": "number"
            },
            "entry": {
              "$ref": "#/$defs/Entry",
              "default": {
                "type": "plunge"
              },
              "description": "Missing: straight down, as before (docs/specs/ramp-entry.md)."
            },
            "feed": {
              "format": "double",
              "type": "number"
            },
            "finish": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Finish"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Rough with stock left on the wall, then one finishing lap at the wall\n(docs/specs/finish-and-skin.md). Missing: none."
            },
            "lead": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Lead"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Arc onto the path from the waste and off it again (docs/specs/helix-and-leads.md,\npart B). Missing: none."
            },
            "name": {
              "default": "",
              "type": "string"
            },
            "plunge_feed": {
              "format": "double",
              "type": "number"
            },
            "select": {
              "$ref": "#/$defs/Selector"
            },
            "side": {
              "$ref": "#/$defs/Side"
            },
            "skin": {
              "anyOf": [
                {
