mesh-error-too-large = modellen är { $bytes } byte; högst 300 MB stöds
mesh-error-too-many-triangles = modellen har { $count } trianglar; högst 5 miljoner stöds: förenkla den
mesh-error-not-stl = ingen STL-fil: en binär STL med det antalet vore { $expected } byte, den är { $found }, och den går inte att läsa som text heller
mesh-error-not-a-number = modellen har ett hörn som inte är ett tal
mesh-error-text = text-STL:en bryts av på rad { $line }
mesh-error-empty = modellen har inga trianglar med en yta
