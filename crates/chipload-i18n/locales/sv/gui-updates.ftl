updates-ask-yes = Leta
updates-ask-no = Leta inte
updates-ask-close-hover = Fråga igen nästa gång
updates-available = Chipload { $version } finns
updates-available-hover = En nyare version finns på GitHub
updates-whats-new = Vad är nytt…
updates-whats-new-hover = Versionens sida på GitHub, i webbläsaren
updates-skip = Hoppa över den här versionen
updates-skip-hover = Ingen notis för { $version }; en senare version visas
updates-check-now = Leta efter nya versioner nu
updates-checking = Letar efter nya versioner…
updates-latest = Chipload { $version } är den senaste versionen
updates-failed = Kunde inte nå GitHub: { $reason }
updates-setting = Nya versioner
