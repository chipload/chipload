# The canvas's navigation bar and orientation cube (crates/chipload-gui/src/app/navigation.rs).

# How you look: short words under icons, and what each does.
navigation-fit = Anpassa
navigation-fit-hover = Anpassa vyn
navigation-top = Ovan
navigation-top-hover = Se rakt uppifrån
navigation-3d = 3D
navigation-3d-hover = 3D: vänsterdra vrider och lutar; högerdra eller Shift+dra panorerar
# $scale: how much the heights are stretched, a plain number.
navigation-3d-stretched-hover = 3D, Z utdragen × { $scale }: vänsterdra vrider och lutar; högerdra eller Shift+dra panorerar

# What is shown. "Stock": the simulated material as it is cut.
navigation-edit = Redigera
navigation-edit-hover = Redigera: rita, markera och ändra ritningen, placera bryggor och startpunkter. Verktygsbanan visas som linjer
navigation-simulate = Simulera
navigation-simulate-busy = Simulera…
navigation-simulating-hover = Simulerar…
navigation-simulate-hover = Simulera: ämnet som programmet lämnar det, med uppspelning. Dra panorerar eller roterar; inget på ritytan redigeras. Redigera eller F6 för att gå tillbaka
navigation-toolpath = Verktygsbana
navigation-toolpath-hover = Visa verktygsbanan; av: bara ritningen eller det simulerade ämnet
navigation-drawing = Ritning
navigation-drawing-hover = Visa ritningens konturer; av: bara ämnet eller verktygsbanan
navigation-images = Bilder
navigation-images-hover = Bilderna som spårats till former, svagt över ämnet
navigation-grid = Rutnät
navigation-grid-hover = Visa rutnätet
navigation-all-parts = Alla detaljer
navigation-all-parts-hover = Beräkna och simulera alla detaljer, inte bara den aktiva. Export skriver alltid alla detaljer.

# The orientation cube: its faces' labels are small capitals on the cube.
navigation-cube-hover = Klicka på en sida för att se mot den
navigation-face-top = OVAN
navigation-face-front = FRAM
navigation-face-right = HÖGER
navigation-face-back = BAK
navigation-face-left = VÄNSTER
