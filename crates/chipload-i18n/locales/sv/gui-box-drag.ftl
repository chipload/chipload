# Dragging the handles of a picture's or text's box (crates/chipload-gui/src/app/box_drag.rs).

# In the status bar when the box can't be dragged to that size; $error says why.
box-drag-not-that-size = Inte den storleken: { $error }
box-drag-cannot-move-shapes = Kunde inte flytta formerna:
box-drag-stretched-fitted = { $count ->
    [one] { $shapes } är nu en polylinje
   *[other] { $shapes } är nu polylinjer
} av linjer och bågar som följer den sträckta kurvan.
