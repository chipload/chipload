# The material-removal simulation shown in the canvas (crates/chipload-gui/src/app/simulation.rs).
# "Stock" is the material being machined.

# Starts lower case: it follows "Simulation failed: ".
simulation-stopped-unexpectedly = simuleringen stannade oväntat
simulation-could-not-start = Simuleringen kunde inte starta: { $error }
simulation-failed = Simuleringen misslyckades: { $error }
# The slider plays the program back; for very long programs only the toolpath moves.
simulation-too-long-to-play = Programmet är för långt för att spela upp ämnet; reglaget visar bara verktygsbanan
