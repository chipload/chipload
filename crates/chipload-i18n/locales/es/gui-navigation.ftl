# The canvas's navigation bar and orientation cube (crates/chipload-gui/src/app/navigation.rs).

# How you look: short words under icons, and what each does.
navigation-fit = Ajustar
navigation-fit-hover = Ajustar la vista
navigation-top = Planta
navigation-top-hover = Mirar desde arriba en vertical
navigation-3d = 3D
navigation-3d-hover = 3D: arrastrar con el botón izquierdo gira e inclina; con el derecho o Shift+arrastrar desplaza
# $scale: how much the heights are stretched, a plain number.
navigation-3d-stretched-hover = 3D, Z estirada × { $scale }: arrastrar con el botón izquierdo gira e inclina; con el derecho o Shift+arrastrar desplaza

# What is shown. "Stock": the simulated material as it is cut.
navigation-simulate = Simular
navigation-simulate-busy = Simular…
navigation-simulating-hover = Simulando…
navigation-simulate-hover = Simular: el material como lo deja el programa, con reproducción. Arrastrar desplaza o gira; no se edita nada en el lienzo. Clic de nuevo o F6 para volver a Editar
navigation-toolpath = Trayectoria
navigation-toolpath-hover = Mostrar la trayectoria; desactivada, solo el dibujo o el material simulado
navigation-drawing = Dibujo
navigation-drawing-hover = Mostrar los contornos del dibujo; desactivado, solo el material o la trayectoria
navigation-images = Imágenes
navigation-images-hover = Las imágenes vectorizadas en formas, tenues sobre el material
navigation-grid = Cuadrícula
navigation-grid-hover = Mostrar la cuadrícula
navigation-all-parts = Todas las piezas
navigation-all-parts-hover = Calcular y simular todas las piezas, no solo la activa. Exportar siempre escribe todas las piezas.

# The orientation cube: its faces' labels are small capitals on the cube.
navigation-cube-hover = Haz clic en una cara para mirarla
navigation-face-top = ARRIBA
navigation-face-front = FRENTE
navigation-face-right = DCHA.
navigation-face-back = DETRÁS
navigation-face-left = IZDA.
