# The material-removal simulation shown in the canvas (crates/chipload-gui/src/app/simulation.rs).
# "Stock" is the material being machined.

# Starts lower case: it follows "Simulation failed: ".
simulation-stopped-unexpectedly = la simulación se detuvo de forma inesperada
simulation-could-not-start = No se pudo iniciar la simulación: { $error }
simulation-failed = La simulación falló: { $error }
# The slider plays the program back; for very long programs only the toolpath moves.
simulation-too-long-to-play = El programa es demasiado largo para reproducir el material; el control deslizante solo muestra la trayectoria
