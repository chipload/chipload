mesh-error-too-large = le modèle fait { $bytes } octets ; 300 Mo au plus sont pris en charge
mesh-error-too-many-triangles = le modèle a { $count } triangles ; 5 millions au plus sont pris en charge : simplifiez-le
mesh-error-not-stl = pas un fichier STL : un STL binaire de ce nombre ferait { $expected } octets, il en fait { $found }, et il ne se lit pas non plus comme texte
mesh-error-not-a-number = le modèle a un sommet qui n'est pas un nombre
mesh-error-text = le STL texte s'interrompt à la ligne { $line }
mesh-error-empty = le modèle n'a aucun triangle ayant une surface
