# The canvas's navigation bar and orientation cube (crates/chipload-gui/src/app/navigation.rs).

# How you look: short words under icons, and what each does.
navigation-fit = Ajuster
navigation-fit-hover = Ajuster la vue
navigation-top = Dessus
navigation-top-hover = Regarder droit vers le bas
navigation-3d = 3D
navigation-3d-hover = 3D : glisser à gauche fait tourner et incliner ; glisser à droite ou Shift+glisser déplace
# $scale: how much the heights are stretched, a plain number.
navigation-3d-stretched-hover = 3D, Z étiré × { $scale } : glisser à gauche fait tourner et incliner ; glisser à droite ou Shift+glisser déplace

# What is shown. "Stock": the simulated material as it is cut.
navigation-stock = Brut
navigation-stock-busy = Brut…
navigation-simulating-hover = Simulation…
navigation-stock-first-hover = Le brut tel qu'usiné : calculez d'abord le parcours d'outil
navigation-toolpath = Parcours
navigation-toolpath-hover = Afficher le parcours d'outil ; désactivé, le dessin ou le brut simulé seul
navigation-drawing = Dessin
navigation-drawing-hover = Afficher les contours du dessin ; désactivé, le brut ou le parcours d'outil seul
navigation-images = Images
navigation-images-hover = Les images vectorisées en formes, en transparence sur le brut
navigation-grid = Grille
navigation-grid-hover = Afficher la grille
navigation-all-parts = Toutes les pièces
navigation-all-parts-hover = Calculer et simuler chaque pièce, pas seulement l'active. L'export écrit toujours chaque pièce.

# The orientation cube: its faces' labels are small capitals on the cube.
navigation-cube-hover = Cliquer une face pour la regarder
navigation-face-top = DESSUS
navigation-face-front = AVANT
navigation-face-right = DROITE
navigation-face-back = ARRIÈRE
navigation-face-left = GAUCHE
