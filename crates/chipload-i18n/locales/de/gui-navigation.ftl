# The canvas's navigation bar and orientation cube (crates/chipload-gui/src/app/navigation.rs).

# How you look: short words under icons, and what each does.
navigation-fit = Einpassen
navigation-fit-hover = Die Ansicht einpassen
navigation-top = Oben
navigation-top-hover = Senkrecht von oben schauen
navigation-3d = 3D
navigation-3d-hover = 3D: Ziehen mit links dreht und neigt; Ziehen mit rechts oder Shift+Ziehen verschiebt
# $scale: how much the heights are stretched, a plain number.
navigation-3d-stretched-hover = 3D, Z gestreckt × { $scale }: Ziehen mit links dreht und neigt; Ziehen mit rechts oder Shift+Ziehen verschiebt

# What is shown. "Stock": the simulated material as it is cut.
navigation-simulate = Simulieren
navigation-simulate-busy = Simulieren…
navigation-simulating-hover = Simulation läuft…
navigation-simulate-hover = Simulieren: das Rohteil, wie das Programm es hinterlässt, mit Wiedergabe. Ziehen verschiebt oder dreht; auf der Zeichenfläche wird nichts bearbeitet. Erneut klicken oder F6 für Bearbeiten
navigation-toolpath = Werkzeugweg
navigation-toolpath-hover = Den Werkzeugweg zeigen; aus: nur die Zeichnung oder das simulierte Rohteil
navigation-drawing = Zeichnung
navigation-drawing-hover = Die Konturen der Zeichnung zeigen; aus: nur das Rohteil oder der Werkzeugweg
navigation-images = Bilder
navigation-images-hover = Die in Formen nachgezeichneten Bilder, blass über dem Rohteil
navigation-grid = Raster
navigation-grid-hover = Das Raster zeigen
navigation-all-parts = Alle Teile
navigation-all-parts-hover = Jedes Teil berechnen und simulieren, nicht nur das aktive. Exportieren schreibt immer jedes Teil.

# The orientation cube: its faces' labels are small capitals on the cube.
navigation-cube-hover = Eine Fläche anklicken, um auf sie zu schauen
navigation-face-top = OBEN
navigation-face-front = VORNE
navigation-face-right = RECHTS
navigation-face-back = HINTEN
navigation-face-left = LINKS
