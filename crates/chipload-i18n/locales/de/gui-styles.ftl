# Styles: operations saved by name (docs/specs/styles.md). "Save as style…" is a menu
# entry on an operation; the ribbon button is named Style.
styles-folder = Stile
styles-folder-hover = Ihre unter einem Namen gespeicherten Bearbeitungen, mit einem Klick auf andere Formen anwendbar
styles-count = { $count ->
    [one] { $count } Stil
   *[other] { $count } Stile
} in Ihrer Bibliothek.
styles-about = Ein Stil ist eine mit „Als Stil speichern…“ gesicherte Bearbeitung: ihre Einstellungen, Tiefen und ihr Werkzeug, ohne ihre Formen. Formen auswählen, dann Stil im Menüband (oder Rechtsklick auf die Zeichenfläche). Die Vorschübe kommen aus den Schnittdaten des Werkzeugs für das Material.
styles-gone = Dieser Stil ist nicht mehr in Ihrer Bibliothek.
styles-entry-about = Formen auswählen, dann Anwenden, um die Bearbeitung dieses Stils für sie hinzuzufügen. Eine Änderung hier ändert nur den Stil: schon damit erstellte Bearbeitungen bleiben, wie sie sind.
styles-name = Name
styles-rename = Umbenennen
styles-apply = Auf die Auswahl anwenden
styles-apply-hover = Die Bearbeitung dieses Stils für die auf der Zeichenfläche ausgewählten Formen hinzufügen, am Ende des aktiven Teils
styles-apply-menu = Stil anwenden
styles-select-first = Zuerst Formen auf der Zeichenfläche auswählen
styles-none-yet = Noch keine Stile: eine Bearbeitung mit „Als Stil speichern…“ sichern
styles-ribbon = Stil
styles-ribbon-hover = Einen Ihrer Stile für die ausgewählten Formen hinzufügen
styles-ribbon-none-hover = Noch keine Stile: Rechtsklick auf eine Bearbeitung, „Als Stil speichern…“
styles-save-as = Als Stil speichern…
styles-save-as-hover = Die Einstellungen und das Werkzeug dieser Bearbeitung unter einem Namen behalten, um sie auf andere Formen anzuwenden
styles-save-title = Als Stil speichern
styles-save-name = Name des Stils
styles-save-about = Ihre Formen, Startpunkte und von Hand gesetzten Haltestege werden nicht übernommen; die Vorschübe kommen beim Anwenden vom Werkzeug.
styles-saved = Stil „{ $name }“ gespeichert
styles-unreadable = nicht lesbar
styles-side-by-selection = Seite nach Auswahl
styles-through = durch + { $below }
styles-depth = { $depth } tief
styles-tabs = { $count ->
    [one] { $count } Haltesteg
   *[other] { $count } Haltestege
}
styles-tool-missing = { $tool } (nicht in Ihrer Bibliothek)
styles-side-selection = nach Auswahl
styles-side-hover = Nach Auswahl: Umrisse werden außen, Löcher innen gefräst, wie bei einer neuen Kontur. Auf der Linie: auf jeder Form, auf die der Stil angewendet wird.
styles-tool-not-in-library = nicht in Ihrer Bibliothek: Werkzeug wählen
styles-save-first = Zuerst die Änderungen speichern oder verwerfen
styles-feeds-note = Hat das Werkzeug Schnittdaten für das Material des Projekts, werden beim Anwenden des Stils deren Vorschübe und Zustellung statt dieser verwendet.
styles-save-hover = Die Änderungen in den Stil schreiben
