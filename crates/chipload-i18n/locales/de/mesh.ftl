mesh-error-too-large = das Modell hat { $bytes } Bytes; höchstens 300 MB werden unterstützt
mesh-error-too-many-triangles = das Modell hat { $count } Dreiecke; höchstens 5 Millionen werden unterstützt: vereinfache es
mesh-error-not-stl = keine STL-Datei: eine binäre STL mit ihrer Anzahl hätte { $expected } Bytes, sie hat { $found }, und als Text lässt sie sich auch nicht lesen
mesh-error-not-a-number = das Modell hat eine Ecke, die keine Zahl ist
mesh-error-text = die Text-STL bricht in Zeile { $line } ab
mesh-error-empty = das Modell hat keine Dreiecke mit Fläche
