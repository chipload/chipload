# The canvas's navigation bar and orientation cube (crates/chipload-gui/src/app/navigation.rs).

# How you look: short words under icons, and what each does.
navigation-fit = Fit
navigation-fit-hover = Fit the view
navigation-top = Top
navigation-top-hover = Look straight down
navigation-3d = 3D
navigation-3d-hover = 3D: left-drag turns and tilts; right-drag or Shift+drag pans
# $scale: how much the heights are stretched, a plain number.
navigation-3d-stretched-hover = 3D, Z stretched × { $scale }: left-drag turns and tilts; right-drag or Shift+drag pans

# What is shown. "Stock": the simulated material as it is cut.
navigation-simulate = Simulate
navigation-simulate-busy = Simulate…
navigation-simulating-hover = Simulating…
navigation-simulate-hover = Simulate: the stock as the program leaves it, with playback. Drags pan or orbit; nothing on the canvas is edited. Click again or F6 to go back to Edit
navigation-toolpath = Toolpath
navigation-toolpath-hover = Show the toolpath; off, the drawing or the simulated stock alone
navigation-drawing = Drawing
navigation-drawing-hover = Show the drawing's contours; off, the stock or the toolpath alone
navigation-images = Images
navigation-images-hover = The pictures traced into shapes, faintly over the stock
navigation-grid = Grid
navigation-grid-hover = Show the grid
navigation-all-parts = All parts
navigation-all-parts-hover = Generate and simulate every part, not only the active one. Export always writes every part.

# The orientation cube: its faces' labels are small capitals on the cube.
navigation-cube-hover = Click a face to look at it
navigation-face-top = TOP
navigation-face-front = FRONT
navigation-face-right = RIGHT
navigation-face-back = BACK
navigation-face-left = LEFT
