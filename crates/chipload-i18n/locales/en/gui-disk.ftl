# The open project's file changed on disk, written by another program
# (crates/chipload-gui/src/app/disk.rs).

# Followed by the reason on the next line.
disk-cannot-load = { $file } changed on disk but can't be loaded:
disk-unchanged = The project shown is unchanged.
disk-reloaded-report = Reloaded { $file }: it changed on disk. Ctrl+Z goes back.
disk-reloaded = Reloaded { $file } (changed on disk)
