# View > Measure, in the status bar (crates/chipload-gui/src/app/measure.rs).

# $snapped: empty, or "— snapped to …" with a space before it.
measure-first-point = Measure: click the first point{ $snapped } (Alt: no snapping; Esc or M ends)
measure-second-point = Measure: click the second point{ $snapped }
# After the measured length, ΔX, ΔY and angle.
measure-again = click to measure again, Esc or M ends
