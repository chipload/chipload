# Styles: operations saved by name (docs/specs/styles.md). "Save as style…" is a menu
# entry on an operation; the ribbon button is named Style.
styles-folder = Styles
styles-folder-hover = Your operations saved by name, to use again on other shapes in one click
styles-count = { $count ->
    [one] { $count } style
   *[other] { $count } styles
} in your library.
styles-about = A style is an operation saved with Save as style…: its settings, depths and tool, without its shapes. Select shapes, then Style on the ribbon (or right-click the canvas) to add it. Its feeds come from the tool's cutting data for the material.
styles-gone = This style is no longer in your library.
styles-entry-about = Select shapes, then Apply to add this style's operation for them. Changing the style here changes only the style: operations already made with it stay as they are.
styles-name = Name
styles-rename = Rename
styles-apply = Apply to the selection
styles-apply-hover = Add this style's operation for the shapes selected on the canvas, at the end of the active part
styles-apply-menu = Apply style
styles-select-first = Select shapes on the canvas first
styles-none-yet = No styles yet: save an operation with Save as style…
styles-ribbon = Style
styles-ribbon-hover = Add one of your styles for the selected shapes
styles-ribbon-none-hover = No styles yet: right-click an operation, Save as style…
styles-save-as = Save as style…
styles-save-as-hover = Keep this operation's settings and tool by name, to use again on other shapes
styles-save-title = Save as style
styles-save-name = Name of the style
styles-save-about = Its shapes, start points and tabs placed by hand aren't kept; its feeds come from the tool when it is used.
styles-saved = Saved style "{ $name }"
styles-unreadable = can't be read
styles-side-by-selection = side by the selection
styles-through = through + { $below }
styles-depth = { $depth } deep
styles-tabs = { $count ->
    [one] { $count } tab
   *[other] { $count } tabs
}
styles-tool-missing = { $tool } (not in your library)
styles-side-selection = by the selection
styles-side-hover = By the selection: outlines are cut outside and holes inside, as a new profile is. On the line: on every shape it is used on.
styles-tool-not-in-library = not in your library: choose a tool
styles-save-first = Save or revert the changes first
styles-feeds-note = Where the tool has cutting data for the project's material, its feeds and step down are used instead of these when the style is applied.
styles-save-hover = Write the changes into the style
