# The canvas's navigation bar and orientation cube (crates/chipload-gui/src/app/navigation.rs).

# How you look: short words under icons, and what each does.
navigation-fit = Adatta
navigation-fit-hover = Adatta la vista
navigation-top = Alto
navigation-top-hover = Guarda dritto dall'alto
navigation-3d = 3D
navigation-3d-hover = 3D: trascina col tasto sinistro per ruotare e inclinare; col tasto destro o Shift+trascina per spostare
# $scale: how much the heights are stretched, a plain number.
navigation-3d-stretched-hover = 3D, Z allungata × { $scale }: trascina col tasto sinistro per ruotare e inclinare; col tasto destro o Shift+trascina per spostare

# What is shown. "Stock": the simulated material as it is cut.
navigation-stock = Grezzo
navigation-stock-busy = Grezzo…
navigation-simulating-hover = Simulazione…
navigation-stock-first-hover = Il grezzo come lavorato: calcola prima il percorso utensile
navigation-toolpath = Percorso
navigation-toolpath-hover = Mostra il percorso utensile; spento, solo il disegno o il grezzo simulato
navigation-drawing = Disegno
navigation-drawing-hover = Mostra i contorni del disegno; spento, solo il grezzo o il percorso utensile
navigation-images = Immagini
navigation-images-hover = Le immagini vettorizzate in forme, tenui sopra il grezzo
navigation-grid = Griglia
navigation-grid-hover = Mostra la griglia
navigation-all-parts = Tutti i pezzi
navigation-all-parts-hover = Calcola e simula ogni pezzo, non solo quello attivo. Esporta scrive sempre ogni pezzo.

# The orientation cube: its faces' labels are small capitals on the cube.
navigation-cube-hover = Clic su una faccia per guardarla
navigation-face-top = SOPRA
navigation-face-front = FRONTE
navigation-face-right = DESTRA
navigation-face-back = RETRO
navigation-face-left = SINISTRA
