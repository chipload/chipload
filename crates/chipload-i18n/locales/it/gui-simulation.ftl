# The material-removal simulation shown in the canvas (crates/chipload-gui/src/app/simulation.rs).
# "Stock" is the material being machined.

# Starts lower case: it follows "Simulation failed: ".
simulation-stopped-unexpectedly = la simulazione si è fermata in modo imprevisto
simulation-could-not-start = Impossibile avviare la simulazione: { $error }
simulation-failed = Simulazione non riuscita: { $error }
# The slider plays the program back; for very long programs only the toolpath moves.
simulation-too-long-to-play = Il programma è troppo lungo per riprodurre il grezzo; il cursore mostra solo il percorso utensile
