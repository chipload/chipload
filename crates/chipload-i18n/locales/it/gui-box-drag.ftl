# Dragging the handles of a picture's or text's box (crates/chipload-gui/src/app/box_drag.rs).

# In the status bar when the box can't be dragged to that size; $error says why.
box-drag-not-that-size = Dimensione non possibile: { $error }
box-drag-cannot-move-shapes = Impossibile spostare le forme:
box-drag-stretched-fitted = { $count ->
    [one] { $shapes } ora è una polilinea
   *[other] { $shapes } ora sono polilinee
} di linee e archi che seguono la curva stirata.
